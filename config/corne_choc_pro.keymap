#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

&mt {
    flavor = "balanced";
	quick-tap-ms = <190>;
};

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E     |  R  |  T     |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D     |  F  |  G     |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C     |  V  |  B     |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | mo4TAB | LWR | lt3ENT |               | SPC | RSE  | ALT |
            bindings = <
                &kp TAB   &kp Q        &kp W 	  &kp E       &kp R      &kp T 	&kp C_MUTE &kp C_PP   &kp Y     &kp U 	 	&kp I 			&kp O 		&kp P    		&kp BSPC
                &kp LCTRL &mt LSHIFT A &mt LGUI S &mt LCTRL D &mt LALT F &kp G 	&kp LALT   &kp RALT   &kp H     &mt RALT J 	&mt RCTRL K     &mt LGUI L  &mt RSHIFT SEMI &kp SQT
                &kp LSHFT &kp Z        &kp X 	  &kp C 	  &kp V      &kp B                     	  &kp N     &kp M  		&kp COMMA 		&kp DOT 	&kp FSLH 		&kp ESC
                                                  &lt 4 TAB   &mo 1      &lt 3 RET 					  &kp SPACE &mo 2       &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        lower_layer {
            display-name = "NAVIG";
            // -----------------------------------------------------------------------------------------
            // |  TAB | ESC |     |     |     |       |  LCTRL | RCTRL |     |     | ENT | BSPC | DEL | BSPC |
            // | CTRL |     |     |     |     |       |  LALT  | RALT  | LFT | DWN |  UP | RGT  |     |      |
            // | SHFT |     |     |     |     |       |        |       |     |     |     |      |     |      |
            //                    |     |     | SPC   |        |       |     |     |
            bindings = <
                &kp TAB   &kp ESC &trans &trans &trans &trans &kp LCTRL &kp RCTRL &trans   &trans   &kp RET &kp BSPC  &kp DEL &kp BSPC
                &kp LCTRL &trans  &trans &trans &trans &trans &kp LALT  &kp RALT  &kp LEFT &kp DOWN &kp UP  &kp RIGHT &trans  &trans
                &kp LSHFT &trans  &trans &trans &trans &trans 					  &trans   &trans   &trans  &trans    &trans  &trans
                                         &trans &trans &kp SPACE                  &trans   &trans   &trans
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
            // --------------------------------------------------------------------------------------------
            // |  TAB |  `  |  [  |  ]  |  \  |     | LCTRL | RCTRL |     |     |      |     |      | BSPC |
            // | CTRL |     |     |     |     |     |  LALT | RALT  |     | ALT | CTRL |     | SHFT |      |
            // | SHFT |     |     |     |     |     |               |     |     |      |     |      |      |
            //                    |     |     | SPC |               | ENT |     |      |
            bindings = <
                &kp  TAB  &kp GRAVE &kp LBKT &kp RBKT &kp BSLH &trans &kp LCTRL &kp RCTRL &trans &trans &trans &trans &trans &kp BSPC
                &kp LCTRL &trans   &trans &trans   &trans   &trans    &kp LALT  &kp RALT  &trans &kp RALT &kp RCTRL &kp RBKT &kp RSHIFT &kp GRAVE
                &kp LSHFT &trans   &trans &trans   &trans   &trans                        &trans &trans &trans &trans &trans &kp TILDE
                                          &trans   &kp TAB  &kp SPACE                     &kp RET   &trans    &trans            
			>;
        };

        extra_layer_1 {
            display-name = "NUMPAD";
            // --------------------------------------------------------------------------------------------
            // |      |     |     |     |     |     | LCTRL | RCTRL |     |     |      |     |      |      |
            // |      |     |     |     |     |     |  LALT | RALT  |     |     |      |     |      |      |
            // |      |     |     |     |     |     |               |     |     |      |     |      |      |
            //                    |     |     |     |               |     |     |      |
            bindings = <
                &trans &trans &trans   &kp UP 	&trans 	  &trans &trans &trans &trans   &kp N7 &kp N8 &kp N9 &kp BSPC  &kp KP_MINUS
                &trans &trans &kp LEFT &kp DOWN	&kp RIGHT &trans &trans &trans &trans   &kp N4 &kp N5 &kp N6 &kp DEL   &kp KP_EQUAL
                &trans &trans &trans   &trans   &trans    &trans           	   &kp RET &kp N1 &kp N2 &kp N3 &kp DOT    &kp APOS
                                       &trans   &trans    &trans               &kp SPACE &kp N0 &kp RET       
            >;
        };

        extra_layer_2 {
            display-name = "CONFIG";
            bindings = <
                &trans &trans 		&trans 			&trans 		  &trans 		&trans 		 &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &bt BT_SEL 0 &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4 &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &bt BT_CLR   &rgb_ug RGB_TOG &sys_reset    &bootloader   &studio_unlock 			   &trans &trans &trans &trans &trans &trans
                                     				&trans 		  &trans        &trans               	   &trans &trans &trans       
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 2";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans       
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans       
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans       
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans       
            >;
        };
    };
};
